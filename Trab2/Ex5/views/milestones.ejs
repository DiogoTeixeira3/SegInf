<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Milestones · <%= repo %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="page">

    <header class="header">
        <div class="logo">GitTasks</div>
        <nav class="nav">
            <span class="nav-user">Olá, <strong><%= user.name %></strong></span>
            <a href="/" class="nav-link">Home</a>
            <a href="/github" class="nav-link">Repositórios</a>
            <a href="/logout" class="btn btn-outline">Logout</a>
        </nav>
    </header>

    <main class="main">

        <section class="card">
            <h1>Milestones de <%= repo %></h1>

            <% if (milestones.length === 0) { %>
                <p class="muted">Este repositório não tem milestones.</p>
            <% } else { %>

                <ul class="repo-list">
                    <% milestones.forEach(m => { %>
                        <li class="repo-item">

                            <div class="repo-left">
                                <span class="repo-name"><%= m.title %></span>

                                <% if (m.due_on) { %>
                                    <span class="tag tag-green">
                                    Data limite: <%= m.due_on.substring(0, 10) %>
                                </span>
                                <% } else { %>
                                    <span class="tag tag-red">Sem data</span>
                                <% } %>
                            </div>

                            <div class="repo-right">
                                <% if (user.role === 'premium') { %>
                                    <div class="task-list-select">
                                        <label>Lista de Tarefas:</label>

                                        <select class="taskListSelect" name="listId">
                                            <!-- será preenchido via JavaScript -->
                                        </select>

                                        <button type="button" class="btn btn-outline btn-sm createListBtn">
                                            Criar lista nova
                                        </button>
                                    </div>
                                <% } %>

                                    <form action="/tasks/select-list" method="POST">
                                        <input type="hidden" name="repo" value="<%= repo %>">
                                        <input type="hidden" name="title" value="<%= m.title %>">
                                        <input type="hidden" name="due" value="<%= m.due_on %>">

                                        <button class="btn btn-sm btn-primary" type="submit">
                                            Criar Task
                                        </button>
                                    </form>



                            </div>

                        </li>
                    <% }) %>
                </ul>

            <% } %>

        </section>

    </main>

</div>
</body>
</html>

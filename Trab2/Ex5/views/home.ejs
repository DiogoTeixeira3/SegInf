<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>GitTasks</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="page">
    <header class="header">
        <div class="logo">GitTasks</div>
        <nav class="nav">
            <% if (user) { %>
                <span class="nav-user">Olá, <strong><%= user.name %></strong></span>
                <span class="role-badge role-<%= user.role %>"><%= user.role %></span>
                <a href="/github" class="nav-link">Milestones</a>
                <a href="/logout" class="btn btn-outline">Logout</a>
            <% } else { %>
                <a href="/login" class="btn btn-primary">Login com Google</a>
            <% } %>
        </nav>
    </header>

    <main class="main">
        <section class="hero">
            <h1>Bem-vindo ao <span>GitTasks</span></h1>
            <p class="hero-subtitle">
                Liga os teus repositórios GitHub às tuas listas do Google Tasks
                e gere milestones como tarefas.
            </p>

            <% if (!user) { %>
                <a href="/login" class="btn btn-primary btn-lg">Começar com Google</a>
            <% } else { %>
                <a href="/github" class="btn btn-primary btn-lg">Ver milestones</a>
            <% } %>
        </section>

        <% if (user) { %>
            <section class="card">
                <h2>O teu perfil</h2>
                <p><strong>Nome:</strong> <%= user.name %></p>
                <p><strong>Role:</strong> <span class="role-badge role-<%= user.role %>"><%= user.role %></span></p>
                <p class="muted">
                    Em breve aqui podes ver repositórios recentes, últimas tarefas criadas, etc.
                </p>
            </section>
        <% } %>
    </main>

    <footer class="footer">
        <p class="muted">SegInf · ISEL · GitTasks</p>
    </footer>
</div>
</body>
</html>

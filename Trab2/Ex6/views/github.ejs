<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>GitHub · GitTasks</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="page">

    <!-- Header -->
    <header class="header">
        <div class="logo">GitTasks</div>
        <nav class="nav">
            <% if (user) { %>
                <span class="nav-user">Olá, <strong><%= user.name %></strong></span>
                <span class="role-badge role-<%= user.role %>"><%= user.role %></span>
                <a href="/" class="nav-link">Home</a>
                <a href="/auth/logout" class="btn btn-outline">Logout</a>
            <% } else { %>
                <a href="/auth/login" class="btn btn-primary">Login com Google</a>
            <% } %>
        </nav>
    </header>

    <!-- Main -->
    <main class="main">

        <section class="card">
            <% if (!hasGithub) { %>
                <div style="margin-bottom: 1.5rem;">
                    <a href="/auth/github/login" class="btn btn-github">
                        Ligar GitHub
                    </a>
                    <p class="muted" style="margin-top:0.5rem;">
                        Necessário para ver repositórios privados
                    </p>
                </div>
            <% } %>


            <h1>Pesquisar Repositórios Públicos</h1>

            <!-- Caixa de pesquisa -->
            <form action="/github/search" method="GET" class="repo-search-box">
                <input
                        type="text"
                        name="q"
                        placeholder="Nome do repositório (ex: portfolio)"
                        class="input"
                        required
                >
                <button type="submit" class="btn btn-primary">Pesquisar</button>
            </form>

            <hr style="margin:1.5rem 0; border-color:rgba(255,255,255,0.2);">

            <% if (!repos || repos.length === 0) { %>

                <p class="muted">Nenhum repositório encontrado.</p>

            <% } else { %>

                <ul class="repo-list">
                    <% repos.forEach(repo => { %>
                        <li class="repo-item">

                            <div class="repo-left">

                                <span class="repo-name"><%= repo.full_name %></span>

                                <% if (repo.private) { %>
                                    <span class="tag tag-red">PRIVATE</span>
                                <% } else { %>
                                    <span class="tag tag-green">PUBLIC</span>
                                <% } %>

                                <% if (repo.description) { %>
                                    <p class="muted"><%= repo.description %></p>
                                <% } %>

                            </div>

                            <div class="repo-right">
                                <a href="/github/<%= encodeURIComponent(repo.full_name) %>/milestones"
                                   class="btn btn-sm btn-primary">
                                    Ver milestones
                                </a>

                            </div>

                        </li>
                    <% }) %>
                </ul>

            <% } %>

        </section>

    </main>

    <footer class="footer">
        <p class="muted">SegInf · ISEL · GitTasks</p>
    </footer>

</div>
</body>
</html>
